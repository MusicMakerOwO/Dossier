{
  "name": "dossier",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check": "echo \"Running linter...\" && eslint . && echo \"Checking for errors ...\" && tsgo  --noEmit",
    "build": "echo \"Running linter...\" && eslint . && echo \"Checking for errors ...\" && tsgo  --noEmit && echo \"Clearing old files...\" && rm -rf build/ && echo \"Building...\" && tsgo",
    "linecount": "find . -type f -name '*.ts' -not -path './node_modules/*' -not -path './build/*' -exec wc -l {} + | sort -n -r | head -n 10",
    "register": "node ./build/register.js",
    "start": "node ./build/index.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "simplyjs": "^1.5.0-alpha",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.10.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
